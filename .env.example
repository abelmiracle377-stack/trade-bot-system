# Example environment variables (copy to .env and adjust)
# Currently the system is mostly config-driven via YAML,
# but these can be used for future broker API keys, etc.

# Logging
LOG_LEVEL=INFO

# Optional: override data start date
# DATA_START_DATE=2018-01-01

# Future: broker credentials (never commit real secrets)
# BROKER_API_KEY=
# BROKER_API_SECRET=
# BROKER_PAPER=true
